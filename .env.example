DATASET_DIR=Capstone_Project_Dataset_FTTT_2026
REFERENCE_DATE=2026-10-20
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=
# Optional compatible-API reasoning setting; keep empty for local Ollama.
LLM_REASONING_EFFORT=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT=120
RAG_LLM_TIMEOUT=120
COMPOSE_WITH_LLM=true
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
DENSE_ENABLED=true

# Added regional languages use local NLLB ONNX, installed by setup.py --regional-languages.
TRANSLATION_ENGINE=local

UI_RESPONSE_BUDGET=180

RAG_RESPONSE_BUDGET=180

SPEECH_REQUEST_BUDGET=90

# Faster hosted application: put LLM_API_KEY in ignored .env.hosted, then run
# python scripts/run_app.py --hosted (UI) or add --hosted to the batch command.
# The normal .env and local evaluation drivers remain separate.
