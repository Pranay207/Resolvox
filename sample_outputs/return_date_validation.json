  "cases": [
    {
      "id": "missing_date_hindi",
      "question": "जूते लौटाने के लिए कितने दिन मिलते हैं और पिकअप शुल्क कितना है? ऑर्डर की तारीख नहीं पता।",
      "prediction": {
        "transcript": "जूते लौटाने के लिए कितने दिन मिलते हैं और पिकअप शुल्क कितना है? ऑर्डर की तारीख नहीं पता।",
        "answer": "मैं ZentroMart की AI सहायता सहायक हूँ। वापसी की अवधि सामान्यतः 15 कैलेंडर दिन है। यदि ऑर्डर 01 अक्टूबर 2026 से 15 अक्टूबर 2026 के बीच रखा गया है, तो अवधि 30 कैलेंडर दिन है। पिकअप शुल्क ₹49 है, पर यह शुल्क केवल मन बदलने के कारण लौटाए जाने पर लागू होता है। यदि वस्तु क्षतिग्रस्त, दोषपूर्ण या गलत है, या आप ZentroMart Plus सदस्य हैं, तो पिकअप शुल्क माफ़ किया जाता है।\n\nकृपया ऑर्डर की तारीख बताएं ताकि यह तय किया जा सके कि कौन सी अवधि लागू होती है।",
        "intent": "return",
        "decision": "clarify",
        "language": "hi",
        "retrieved_chunk_ids": [
          "STY-1",
          "RET-2",
          "RET-6",
